# ---------- connections ----------
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY   # paid RPC: public RPC rate-limits the holder/seller scans
DATABASE_URL=postgres://...                                # Neon works
PORT=8787
DRY_RUN=true            # decide + log only. Set false to move funds.

# ---------- launch (npm run launch) ----------
DEV_KEYPAIR=C:/path/to/your/dev-wallet.json   # yours; never generated here
TOKEN_NAME=
TOKEN_SYMBOL=
TOKEN_IMAGE=./logo.png
TOKEN_DESCRIPTION=
TWITTER=
TELEGRAM=
WEBSITE=
DEV_BUY_PUMP=0          # whole $PUMP for the dev's first buy, in the same tx as the create
# MINT_KEYPAIR=./keys/vanity-mint.json
# LOOKUP_TABLE=          # printed by --rehearse; reuse it for --send
# CREATOR_FEE_BPS=210    # 2.1% total = 0.7% per bucket (pump.fun max is 300)

# ---------- engine (MINT / LAUNCH_TIME / DEV_WALLET come from the launch output) ----------
MINT=
LAUNCH_TIME=
DEV_WALLET=             # included in airdrops
# Paths, or the JSON byte array itself (for hosts like Render):
TREASURY_KEYPAIR=./keys/treasury.json   # the coin's creator: receives the 2.1% and splits it three ways
VOLUME_KEYPAIR=./keys/buyer.json     # bucket 1 funder (seeds throwaway subs). Falls back to BUYER_KEYPAIR if unset.
BOT_KEYPAIR=./keys/bot.json
AIRDROP_KEYPAIR=./keys/airdrop.json

# ---------- bucket 1: volume bot (atomic buy+sell through rotating throwaway wallets) ----------
VOLUME_EVERY_MS=90000                # one buy+sell cycle about every 90s...
VOLUME_TIMING_JITTER=0.6             # ...+/-30%, so it isn't a metronome
VOLUME_CYCLES_PER_WALLET=6           # rotate to a fresh throwaway sub after this many cycles (anti-cluster)
VOLUME_FUND_PCT=0.2                  # seed ~20% of the bucket into each new sub
VOLUME_FUND_JITTER=0.4               # seed size varies +/-20%
VOLUME_MIN_QUOTE=100000000           # raw $PUMP (100): smallest seed / cycle, and the bucket minimum
VOLUME_MAX_IMPACT_PCT=0.01           # no single buy moves price more than 1%
VOLUME_SUB_SOL_LAMPORTS=10000000     # 0.01 SOL seeded to each sub for gas + ATA rent (swept back on drain)
# the funder wallet must hold SOL to seed subs; top it up like any engine wallet

# ---------- bucket 2: price stabilizer ----------
BOT_TRANCHES=0.15:10,0.25:20,0.35:30,0.5:40  # below-anchor:weight. Deeper dips get more of the bucket
BOT_ANCHOR_WINDOW_MS=21600000        # anchor = 6h time-weighted average price
BOT_MIN_ANCHOR_SAMPLES=60            # no trading until 60 price samples (30 min) exist
BOT_REARM_GAP=0.1                    # a fired tranche re-arms 10% above its level
BOT_TOP_STEP_PCT=0.5                 # sell half the bag at +50%, +100%, +150%... over avg entry
BOT_MIN_SELL_PREMIUM=0.1             # ...and only when price is 10%+ above the anchor and rising
BOT_MOMENTUM_MS=600000               # "rising" = at or above the price 10 min ago
BOT_MAX_IMPACT_PCT=0.02              # each swap moves price at most 2%; bigger orders are sliced
BOT_SLICE_GAP_MS=90000               # ~90s between slices
BOT_SLICE_JITTER=0.5                 # gap varies +/-25% so slices aren't predictable
BOT_CRASH_PCT=0.6                    # a 60% fall from the 15-min high pauses buying...
BOT_CRASH_WINDOW_MS=900000
BOT_PAUSE_MS=1800000                 # ...for 30 min
BOT_MIN_QUOTE=1000000000             # raw $PUMP (1,000) before the bot will buy
BOT_MIN_TOKENS=1000000000            # raw tokens before it will sell
SLIPPAGE_PCT=5

# ---------- bucket 3: DLMM liquidity + loyalty fee airdrop ----------
# Post-migration the bucket's $PUMP is LP principal on a coin/$PUMP Meteora DLMM
# pool (created by the engine, kept in range); the position's earned fees are
# claimed, converted to $PUMP, and airdropped each round to 1h+ holders.
AIRDROP_TIERS=1:1,24:1.5,72:2,168:3  # hours:multiplier. First tier = eligibility age. Any sell resets to 0
AIRDROP_EVERY_MS=3600000             # one fee-airdrop round per hour
AIRDROP_MIN_BALANCE=1000000          # raw tokens to count as a holder
AIRDROP_MIN_PAYOUT=1000000           # shares smaller than this are re-split, not sent
DLMM_HALF_WIDTH=34                   # bins each side of the active bin (the position width)
DLMM_KEEP_WIDTH=true                 # reuse the current width when re-centering
DLMM_MIN_QUOTE=1000000000            # raw $PUMP (1,000): smallest LP deploy
DLMM_BIN_STEP=100                    # pool bin step in bps, only used when the engine creates the pair
DLMM_BASE_FEE_BPS=100                # pool base fee in bps, only used on pool creation
DLMM_SLIPPAGE_BPS=50                 # swap/add slippage for LP operations

# ---------- operations ----------
TICK_MS=30000
CLAIM_EVERY_MS=600000
MIN_SOL_LAMPORTS=5000000             # a wallet under 0.005 SOL stops sending (dashboard warns)
FAIL_BACKOFF_MS=300000               # a failed money step sits out this long
PRIORITY_MICRO_LAMPORTS=50000
# DB_POOL_MAX=5
